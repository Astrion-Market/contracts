{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrion.market/spec/v1/quote.schema.json",
  "title": "Route quote",
  "type": "object",
  "required": ["schemaVersion", "intentId", "quotedAt", "validUntil", "legs", "totalFee", "expectedReceived"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "intentId": { "$ref": "common.schema.json#/$defs/bytes32" },
    "quotedAt": { "$ref": "common.schema.json#/$defs/unixSeconds" },
    "validUntil": { "$ref": "common.schema.json#/$defs/unixSeconds" },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "network", "fee", "etaSecs"],
        "properties": {
          "kind": { "enum": ["cctp_burn", "cctp_mint", "protocol_action"] },
          "network": { "$ref": "common.schema.json#/$defs/networkId" },
          "fee": { "$ref": "common.schema.json#/$defs/amount" },
          "etaSecs": {
            "description": "Estimate only. Never a liquidation buffer or delivery guarantee.",
            "type": "integer", "minimum": 0
          }
        }
      }
    },
    "totalFee": { "$ref": "common.schema.json#/$defs/amount" },
    "expectedReceived": { "$ref": "common.schema.json#/$defs/amount" },
    "retainedDust": {
      "description": "Source-side remainder that cannot be represented in CCTP units (Stellar 7th decimal).",
      "$ref": "common.schema.json#/$defs/amount"
    }
  }
}
